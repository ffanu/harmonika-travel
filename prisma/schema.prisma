generator client {
  provider = "prisma-client-js"
  // "native" keeps local macOS/Linux development working; the explicit target ships the
  // engine for the Ubuntu 22.04 (OpenSSL 3.0) deployment host.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Category {
  HOTEL
  FLIGHT
  AIRPORT_TRANSFER
  CAR_RENTAL
  ACTIVITY
  CRUISE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLATION_REQUESTED
  CANCELLED
  COMPLETED
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  phone String?
  role Role @default(CUSTOMER)
  sessions Session[]
  bookings Booking[]
  wishlist Wishlist[]
  auditLogs AuditLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model Destination {
  id String @id @default(cuid())
  slug String @unique
  name String
  country String
  description String @default("")
  imageUrl String?
  products Product[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id String @id @default(cuid())
  slug String @unique
  name String
  category Category
  description String
  imageUrl String?
  location String
  destinationId String
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  active Boolean @default(false)
  isDemo Boolean @default(true)
  variants Variant[]
  wishlist Wishlist[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([category, active])
  @@index([destinationId])
}

model Variant {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  name String
  description String @default("")
  priceIdr Int
  active Boolean @default(true)
  schedules Schedule[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([productId])
}

model Schedule {
  id String @id @default(cuid())
  variantId String
  variant Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  startsAt DateTime
  endsAt DateTime
  capacity Int
  reserved Int @default(0)
  priceIdr Int
  active Boolean @default(true)
  bookings Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([variantId, startsAt])
  @@index([startsAt, active])
}

model Booking {
  id String @id @default(cuid())
  reference String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  scheduleId String
  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  idempotencyKey String
  quantity Int
  unitPriceIdr Int
  discountIdr Int @default(0)
  totalIdr Int
  productName String
  variantName String
  contactName String
  contactEmail String
  contactPhone String
  status BookingStatus @default(PENDING)
  isDemo Boolean @default(true)
  cancellationReason String?
  promoId String?
  promo Promo? @relation(fields: [promoId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([scheduleId, status])
}

model Wishlist {
  userId String
  productId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@id([userId, productId])
}

model Promo {
  id String @id @default(cuid())
  code String @unique
  title String
  description String @default("")
  discountIdr Int
  minimumTotalIdr Int @default(0)
  startsAt DateTime
  endsAt DateTime
  active Boolean @default(false)
  bookings Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Partnership {
  id String @id @default(cuid())
  businessName String
  contactName String
  email String
  phone String
  category Category
  message String
  status String @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Content {
  id String @id @default(cuid())
  slug String @unique
  title String
  body String
  published Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id String @id @default(cuid())
  actorId String
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action String
  resource String
  resourceId String
  createdAt DateTime @default(now())
  @@index([actorId, createdAt])
}

model RateLimit {
  key String @id
  count Int @default(1)
  resetsAt DateTime
  @@index([resetsAt])
}
