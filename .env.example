# Salin ke .env dan isi kredensial secara privat. Jangan commit .env.
# Encode karakter khusus username/password sebagai URL.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/www_harmonikatravel_com?schema=harmonika_travel"
APP_ORIGIN="https://www.harmonikatravel.com"
NODE_ENV="production"

# Rahasia sesi (wajib di produksi). Buat dengan: openssl rand -base64 48
SESSION_SECRET=

# Hanya dipakai scripts/seed.mjs saat membuat admin, tidak dibaca runtime.
SEED_ADMIN_EMAIL="admin@contoh.id"
SEED_ADMIN_PASSWORD=""

# Produksi: port loopback yang sudah diperiksa tersedia.
# PORT=3401
# HOSTNAME=127.0.0.1

# Travelpayouts (server-side saja; jangan diisi nilai asli di repo).
# TRAVELPAYOUTS_TOKEN=
# TRAVELPAYOUTS_MARKER=595040
